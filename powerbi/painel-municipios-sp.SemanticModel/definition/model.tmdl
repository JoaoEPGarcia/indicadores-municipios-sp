model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PastaDados","LerCsv","dim_municipio","dim_indicador","fato_indicador","ref_faixa","previsao","backtest_metodos","backtest_cobertura","Medidas"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Medidas
ref table dim_municipio
ref table dim_indicador
ref table dim_ano
ref table fato_indicador
ref table ref_faixa
ref table previsao
ref table sel_municipio
ref table backtest_metodos
ref table backtest_cobertura

