/// Anos da série observada e da Previsão da receita. Vai do primeiro ano dos dados ao último ano previsto.
table dim_ano

	column ano
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [ano]

	partition dim_ano = calculated
		mode: import
		source =
				VAR primeiro = MIN ( fato_indicador[ano] )
				VAR ultimo = MAX ( MAX ( fato_indicador[ano] ), MAX ( previsao[ano] ) )
				RETURN
					SELECTCOLUMNS ( GENERATESERIES ( primeiro, ultimo, 1 ), "ano", [Value] )

